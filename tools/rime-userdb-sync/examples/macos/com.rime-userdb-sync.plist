<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rime-userdb-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON_BIN__</string>
    <string>__REPO_ROOT__/tools/rime-userdb-sync/main.py</string>
    <string>--config</string>
    <string>__CONFIG_PATH__</string>
    <string>sync</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__WORKING_DIR__</string>

  <key>RunAtLoad</key>
  <false/>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/tmp/rime-userdb-sync.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/rime-userdb-sync.stderr.log</string>
</dict>
</plist>
