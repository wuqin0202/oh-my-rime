{
  "remote_root": "nutstore:rime",
  "device_id": "MacBookAir",
  "rime_user_dir": "~/Library/Rime",
  "local_sync_dir": "~/Library/Rime/.sync",
  "rclone_binary": "rclone",
  "rime_sync_command": [
    "/Library/Input Methods/Squirrel.app/Contents/MacOS/Squirrel",
    "--sync"
  ],
  "include_patterns": [
    "*.userdb.txt"
  ],
  "interval_minutes": 60
}
